  "audit_function_source": "function auditRaw(raw,e){\n const p=JSON.parse(raw),check=(b,m)=>{if(!b)throw Error(e.ordinal+\": \"+m);};\n const near=(a,b)=>Math.abs(a-b)<=1e-12*Math.max(1,Math.abs(a),Math.abs(b));\n const quant=(a,q)=>{const s=[...a].sort((x,y)=>x-y),x=(s.length-1)*q,i=Math.floor(x);return s[i]+(s[Math.min(i+1,s.length-1)]-s[i])*(x-i);};\n const stats=a=>{const median=quant(a,.5);return {median,min:Math.min(...a),max:Math.max(...a),mad:quant(a.map(x=>Math.abs(x-median)),.5),inclusive_iqr:quant(a,.75)-quant(a,.25)};};\n check(p.protocol===\"parseatlas_modn_native_compare_v1\"&&p.mode===\"measurement\"&&p.timing_claim,\"identity\");\n check(p.shape===e.shape&&p.count===e.count&&p.cpu===4&&p.seed===20260905,\"entry\");\n check(p.active_lanes===(e.shape===\"dependent\"?1:8)&&p.boundary_state_bytes===256,\"state\");\n check(p.measurement_workers===1&&p.rhs_bytes_per_representation===e.count*32,\"work size\");\n check(p.samples.length===32&&p.warmups.length===8&&p.calibration.length>0&&p.calibration.length<=8,\"length\");\n check(p.every_warmup_and_measured_final_state_compared_exactly&&p.final_calibration_replayed,\"replay\");\n check(p.preflight_complete_state_checks===e.count*3,\"prefix checks\");\n check(Object.values(p.original_preflight_only_reduction_paths).reduce((a,b)=>a+b,0)===e.count,\"prefix path counts\");\n check(p.passes>0&&p.passes<=1e6&&p.operations_per_sample===p.count*p.passes&&p.operations_per_sample<=1e9,\"bound\");\n check(p.requested_target_ns===200000000&&p.warmup_operations_per_sample===256&&p.sample_rounds===8&&p.warmup_rounds===2,\"protocol\");\n const all=[...p.calibration,...p.warmups,...p.samples];let lastStop=0;\n for(const s of all){\n   check(Number.isSafeInteger(s.start_steady_ns)&&Number.isSafeInteger(s.stop_steady_ns)&&Number.isSafeInteger(s.elapsed_ns),\"exact steady integer\");\n   check(BigInt(s.stop_steady_ns)-BigInt(s.start_steady_ns)===BigInt(s.elapsed_ns)&&s.elapsed_ns>0,\"elapsed\");\n   check(s.start_steady_ns>=lastStop,\"monotonic serial\");lastStop=s.stop_steady_ns;\n   check(s.operations===s.count*s.passes&&s.operations<=1e9&&s.count===e.count,\"sample work\");\n   check(near(s.ns_per_modular_addition,s.elapsed_ns/s.operations),\"ns/add\");\n   check(s.cpu_before===4&&s.cpu_after===4,\"cpu\");\n   check(s.below_requested_target===(s.elapsed_ns<200000000),\"target flag\");\n }\n check(p.calibration.every(s=>s.variant===0),\"calibration control\");\n check(p.calibration.at(-1).checksum===p.reference_checksum&&p.calibration.at(-1).passes===p.passes,\"final calibration state\");\n for(const [kind,rows] of [[\"warmup\",p.warmups],[\"measured\",p.samples]]){\n  rows.forEach((s,i)=>{\n    check(s.round===Math.floor(i/4)&&s.position===i%4,\"position \"+kind);\n    check(s.variant===p.initial_variant_order[(s.position+s.round)%4],\"rotation \"+kind);\n    check(s.checksum===p.reference_checksum&&s.passes===p.passes&&s.operations===p.operations_per_sample,\"replay/work \"+kind);\n  });\n }\n for(let v=0;v<4;v++){\n   const rows=p.samples.filter(s=>s.variant===v),sum=p.summaries.find(s=>s.variant===v);\n   check(rows.length===8&&sum.sample_count===8,\"variant count\");\n   for(let pos=0;pos<4;pos++)check(rows.filter(s=>s.position===pos).length===2,\"position balance\");\n   const ns=stats(rows.map(s=>s.ns_per_modular_addition));\n   for(const [k,vv]of Object.entries(ns))check(near(sum.ns_per_modular_addition[k],vv),\"ns stat \"+k);\n   check(sum.below_target_count===rows.filter(s=>s.below_requested_target).length,\"below count\");\n   if(v===3)check(sum.paired_original_over_candidate===null&&sum.ratio_by_round===null&&!sum.matched_inline_candidate,\"api exclusion\");\n   else{\n    const ratios=Array.from({length:8},(_,r)=>p.samples.find(s=>s.variant===0&&s.round===r).ns_per_modular_addition/p.samples.find(s=>s.variant===v&&s.round===r).ns_per_modular_addition);\n    ratios.forEach((x,i)=>check(near(sum.ratio_by_round[i],x),\"paired ratio\"));\n    for(const [k,vv]of Object.entries(stats(ratios)))check(near(sum.paired_original_over_candidate[k],vv),\"ratio stat \"+k);\n   }\n }\n const stamp=k=>{const m=raw.match(new RegExp('\"'+k+'\":(\\\\d+)'));check(!!m,\"unix timestamp\");return BigInt(m[1]);};\n const start=stamp(\"started_unix_ns\"),finish=stamp(\"finished_unix_ns\");check(finish>start,\"unix order\");\n return {ordinal:e.ordinal,path:e.path,status:\"pass\",started_unix_ns:start.toString(),finished_unix_ns:finish.toString(),samples:p.samples.length,warmups:p.warmups.length,calibration_trials:p.calibration.length,operations_per_sample:p.operations_per_sample,measured_below_target:p.samples.filter(x=>x.below_requested_target).length,elapsed_ns_range:[Math.min(...p.samples.map(x=>x.elapsed_ns)),Math.max(...p.samples.map(x=>x.elapsed_ns))],reference_checksum:p.reference_checksum,preflight_only_paths:p.original_preflight_only_reduction_paths,summaries:p.summaries};\n}"
